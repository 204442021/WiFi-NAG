# WIFI-NAG WiFi/DNS gateway performance profile.
# Applied by env:wifi_nag_ESP32_S3_CAN through SDKCONFIG_DEFAULTS layering.

# Prefer throughput over smallest flash image. WIFI-NAG has plenty of app space.
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# AP+STA+NAPT benefits from more WiFi buffering than a minimal CAN-only build.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_TX_BA_WIN=12
CONFIG_ESP_WIFI_RX_BA_WIN=12

# Give lwIP/NAPT more room for forwarded traffic and dashboard/DNS sockets.
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_LWIP_UDP_RECVMBOX_SIZE=12
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384

# BLE Central receiver runs in its own NimBLE host task.  It is intentionally
# lower priority than the dedicated TWAI/CAN task.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
